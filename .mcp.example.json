{
  "mcpServers": {
    "notion": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@notionhq/notion-mcp-server"],
      "env": {
        "OPENAPI_MCP_HEADERS": "${NOTION_MCP_HEADERS}"
      }
    },
    "google-workspace": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@presto-ai/google-workspace-mcp"],
      "env": {
        "GEMINI_CLI_WORKSPACE_FORCE_FILE_STORAGE": "true"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp"],
      "env": {}
    },
    "cloudflare": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@cloudflare/mcp-server-cloudflare", "run", "${CLOUDFLARE_ACCOUNT_ID}"],
      "env": {
        "CLOUDFLARE_API_TOKEN": "${CLOUDFLARE_API_TOKEN}"
      }
    },
    "zoom": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@prathamesh0901/zoom-mcp-server"],
      "env": {
        "ZOOM_ACCOUNT_ID": "${ZOOM_ACCOUNT_ID}",
        "ZOOM_CLIENT_ID": "${ZOOM_CLIENT_ID}",
        "ZOOM_CLIENT_SECRET": "${ZOOM_CLIENT_SECRET}"
      }
    },
    "square": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "square-mcp-server", "start"],
      "env": {
        "ACCESS_TOKEN": "${SQUARE_ACCESS_TOKEN}",
        "PRODUCTION": "true"
      }
    },
    "clickup": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@chykalophia/clickup-mcp-server"],
      "env": {
        "CLICKUP_API_TOKEN": "${CLICKUP_API_TOKEN}"
      }
    },
    "gohighlevel": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@drausal/gohighlevel-mcp"],
      "env": {
        "BEARER_TOKEN_BEARERAUTH": "${GHL_BEARER_TOKEN}",
        "BEARER_TOKEN_BEARER": "${GHL_BEARER_TOKEN}"
      }
    },
    "firecrawl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "tavily": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "tavily-mcp"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "exa": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      }
    },
    "browserbase": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@browserbasehq/mcp-server-browserbase",
        "--browserbaseApiKey", "YOUR_BROWSERBASE_API_KEY",
        "--browserbaseProjectId", "YOUR_BROWSERBASE_PROJECT_ID",
        "--modelApiKey", "${GEMINI_API_KEY}"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "memwright": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "agent_memory.mcp.server"],
      "env": {
        "MEMWRIGHT_DATA_DIR": "${MEMWRIGHT_DATA_DIR}"
      }
    }
  }
}
