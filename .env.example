# ============================================================
# REQUIRED — Nova cannot start without these
# ============================================================

# Telegram bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Your Telegram user ID (get from /start in @userinfobot)
TELEGRAM_USER_ID=

# Encryption key for sensitive data (generate with: openssl rand -hex 32)
NOVA_ENCRYPTION_KEY=

# ============================================================
# CLAUDE AUTH — choose one method
# ============================================================
# Option A: Claude Code OAuth (uses your Claude.ai subscription)
# Mount your existing Claude credentials from local machine
CLAUDE_HOME_DIR=~/.claude
CLAUDE_CONFIG_DIR=~/.config/@anthropic-ai

# Option B: Anthropic API key (direct billing, pay-per-token)
# Get from console.anthropic.com
# ANTHROPIC_API_KEY=

# ============================================================
# PERSONALIZATION
# ============================================================

# Your first name
USER_NAME=

# AI assistant name shown to users (white-label override)
NOVA_NAME=Nova

# Your timezone (IANA format: America/New_York, Europe/Berlin, etc.)
USER_TIMEZONE=UTC

# ============================================================
# PATHS — Docker defaults (usually no need to change)
# ============================================================

# Data directory for SQLite databases and embeddings
NOVA_DATA_DIR=/data

# Workspace for projects, documents, images
NOVA_WORKSPACE=/workspace

# Nova home directory
NOVA_DIR=/workspace

# Memwright integration server URL
MEMWRIGHT_URL=http://memwright:8765

# Memwright data directory
MEMWRIGHT_DATA_DIR=./data/memwright

# ============================================================
# OPTIONAL — Voice Transcription & TTS
# ============================================================

# Voice provider: "groq" (cloud API) or "local" (whisper.cpp)
# VOICE_PROVIDER=groq

# Groq API key for voice transcription (free at console.groq.com)
GROQ_API_KEY=

# Local whisper.cpp binary path (if using local voice provider)
# WHISPER_BINARY=whisper-cpp

# Local whisper.cpp model path (if using local voice provider)
# WHISPER_MODEL_PATH=~/whisper-models/ggml-base.en.bin

# ElevenLabs API key for text-to-speech
# ELEVENLABS_API_KEY=

# ElevenLabs voice ID (e.g. 21m00Tcm4TlvDq8ikWAM for George)
# ELEVENLABS_VOICE_ID=

# ============================================================
# OPTIONAL — Admin Dashboard & Ports
# ============================================================

# Dashboard login username
# DASHBOARD_USER=admin

# Dashboard login password (required to enable dashboard)
# DASHBOARD_PASS=

# Dashboard server port
DASHBOARD_PORT=3033

# Telegram Mini App server port
MINIAPP_PORT=3034

# Voice server port
VOICE_PORT=8080

# Public domain for HTTPS (e.g. nova.example.com)
# Used with Caddy for automatic HTTPS certificates
# NOVA_DOMAIN=

# ============================================================
# OPTIONAL — Telegram Mini App
# ============================================================

# Public URL for incoming Mini App webhook delivery
# MINIAPP_PUBLIC_URL=https://your-domain.com

# Mini App URL (usually same as MINIAPP_PUBLIC_URL)
# MINIAPP_URL=

# ============================================================
# OPTIONAL — AI Providers (additional beyond Claude)
# ============================================================

# Gemini API key (for Gemini provider)
# GEMINI_API_KEY=

# Codex CLI binary path (auto-detected if in PATH)
# CODEX_PATH=

# ============================================================
# OPTIONAL — Integrations — Messaging
# ============================================================

# Slack bot token (xoxb-...)
# SLACK_BOT_TOKEN=

# Slack app token (xapp-...)
# SLACK_APP_TOKEN=

# Twilio account SID for voice/SMS
# TWILIO_ACCOUNT_SID=

# Twilio auth token for voice/SMS
# TWILIO_AUTH_TOKEN=

# Your Twilio phone number (e.g. +1234567890)
# TWILIO_PHONE_NUMBER=

# Your personal phone number for voice calls
# USER_PHONE=

# PIN for voice call authentication
# USER_PIN=

# Voice server HTTP port
# VOICE_SERVER_PORT=80

# Public URL for the voice server
# VOICE_SERVER_URL=

# Kapso API key for WhatsApp (managed per-user in Mini App)
# KAPSO_API_KEY=

# Kapso phone number (managed per-user in Mini App)
# KAPSO_PHONE_NUMBER=

# ============================================================
# OPTIONAL — Integrations — Research & Web
# ============================================================

# Perplexity API key for web research (from perplexity.ai/settings/api)
# PERPLEXITY_API_KEY=pplx-

# ============================================================
# OPTIONAL — Integrations — Productivity
# ============================================================

# ClickUp API key
# CLICKUP_API_KEY=

# GoHighLevel API key
# GOHIGHLEVEL_API_KEY=

# ============================================================
# OPTIONAL — Integrations — OAuth (configured via Mini App)
# ============================================================

# Google OAuth client ID (also used for YouTube)
# GOOGLE_CLIENT_ID=

# Google OAuth client secret (also used for YouTube)
# GOOGLE_CLIENT_SECRET=

# Notion OAuth client ID
# NOTION_CLIENT_ID=

# Notion OAuth client secret
# NOTION_CLIENT_SECRET=

# Zoom OAuth app client ID
# ZOOM_CLIENT_ID=

# Zoom OAuth app client secret
# ZOOM_CLIENT_SECRET=

# TikTok OAuth client key (from developers.tiktok.com)
# TIKTOK_CLIENT_KEY=

# TikTok OAuth client secret
# TIKTOK_CLIENT_SECRET=

# ============================================================
# OPTIONAL — Meta Ads Integration
# ============================================================

# Meta marketing API access token
# META_ACCESS_TOKEN=

# Meta ad account ID (act_XXXXX)
# META_AD_ACCOUNT_ID=

# Meta app ID (for OAuth)
# META_APP_ID=

# Meta app secret (for OAuth)
# META_APP_SECRET=

# ============================================================
# OPTIONAL — Video Generation
# ============================================================

# HeyGen avatar video API key
# HEYGEN_API_KEY=

# Fal.ai text-to-video API key
# FAL_API_KEY=

# ============================================================
# OPTIONAL — Proactive Services
# ============================================================

# Enable heartbeat (proactive check-ins) — default: true
# HEARTBEAT_ENABLED=true

# Minutes between heartbeat ticks — default: 30
# HEARTBEAT_INTERVAL_MIN=30

# Max proactive messages per user per day — default: 3
# HEARTBEAT_MAX_DAILY=3

# Active window in user's timezone (HH-HH format) — default: 8-22
# HEARTBEAT_ACTIVE_HOURS=8-22

# ============================================================
# OPTIONAL — Legacy Migration (do not use in new setups)
# ============================================================

# Supabase URL (only for migration from old setup)
# SUPABASE_URL=

# Supabase anon key (only for migration from old setup)
# SUPABASE_ANON_KEY=
