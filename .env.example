# ============================================================
# Nova — Environment Variables
# ============================================================
# Copy to .env:  cp .env.example .env
# Then fill in your values below.
# ============================================================

# --- BOT IDENTITY ---

# The name your assistant uses to refer to itself
BOT_NAME=Nova

# --- CHANNELS (at least one required) ---

# Telegram (recommended)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_USER_ID=your_telegram_user_id

# --- OPTIONAL: WhatsApp (Kapso / Meta Cloud API) ---
# WhatsApp is managed per-user (each user provides Kapso API key + Phone Number ID).
# WHATSAPP_WEBHOOK_URL=   # Public URL Kapso posts WhatsApp webhooks to (routes to the relay's WA listener)

# --- OPTIONAL: Slack (Bolt SDK, Socket Mode) ---
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# --- DATABASE ---
# Local SQLite — no configuration needed. Data stored in data/nova.db.
# Embeddings generated locally via @huggingface/transformers (all-MiniLM-L6-v2).

# --- RECOMMENDED: Personalization ---

# Your first name
USER_NAME=Your Name

# Your timezone (IANA format: America/New_York, Europe/Berlin, etc.)
USER_TIMEZONE=UTC

# --- OPTIONAL: Paths ---

# Claude CLI path (auto-detected if in PATH)
# CLAUDE_PATH=claude

# Working directory for Claude (defaults to relay's own directory)
# PROJECT_DIR=/path/to/your/project

# Relay data directory (defaults to ~/.nova)
# RELAY_DIR=~/.nova

# --- OPTIONAL: Voice Transcription ---

# Voice provider: "groq" (free cloud API) or "local" (whisper.cpp on your machine)
# VOICE_PROVIDER=groq

# For Groq: Free API key from console.groq.com
# GROQ_API_KEY=your_groq_key

# For local whisper.cpp:
# WHISPER_BINARY=whisper-cpp
# WHISPER_MODEL_PATH=~/whisper-models/ggml-base.en.bin

# --- OPTIONAL: Perplexity (web research) ---
# API key from perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-...

# --- OPTIONAL: Heartbeat (proactive check-ins) ---
# HEARTBEAT_ENABLED=true          # default: true (disable with "false")
# HEARTBEAT_INTERVAL_MIN=30       # minutes between heartbeat ticks (default: 30)
# HEARTBEAT_MAX_DAILY=3           # max proactive messages per user per day (default: 3)
# HEARTBEAT_ACTIVE_HOURS=8-22     # active window in user's timezone (default: 8-22)

# --- OPTIONAL: AI Providers ---
# GEMINI_API_KEY=                  # Gemini API key (for Gemini provider)
# CODEX_PATH=                      # Path to codex CLI binary (auto-detected if in PATH)

# --- OPTIONAL: Dashboard ---
# DASHBOARD_USER=admin             # Dashboard login username
# DASHBOARD_PASS=                  # Dashboard login password (required to enable dashboard)
# DASHBOARD_PUBLIC_URL=https://your-domain.com/dashboard  # Public URL for the dashboard (used as OAuth redirect base)

# --- OPTIONAL: Twilio (Voice & SMS) ---
# TWILIO_ACCOUNT_SID=              # Twilio account SID
# TWILIO_AUTH_TOKEN=               # Twilio auth token
# TWILIO_PHONE_NUMBER=             # Your Twilio phone number
# USER_PIN=                        # PIN for voice call authentication
# USER_PHONE=                      # Your personal phone number for voice calls
# VOICE_SERVER_PORT=80             # Voice server HTTP port
# VOICE_SERVER_URL=                # Public URL for the voice server (e.g. https://voice.your-domain.com)
# WEBHOOK_BASE_URL=                # Public base URL for webhook endpoints (e.g. https://your-domain.com)

# --- OPTIONAL: Text-to-Speech ---
# ELEVENLABS_API_KEY=              # ElevenLabs TTS API key
# ELEVENLABS_VOICE_ID=             # ElevenLabs voice ID (default: George)

# --- OPTIONAL: Meta Ads ---
# META_ACCESS_TOKEN=               # Meta marketing API access token
# META_AD_ACCOUNT_ID=              # Meta ad account ID (act_XXXXX)
# META_APP_ID=                     # Meta app ID (for OAuth)
# META_APP_SECRET=                 # Meta app secret (for OAuth)

# --- OPTIONAL: Square ---
# SQUARE_LOCATIONS=                # Comma-separated "Name (LOCATION_ID)" pairs mentioned by the voice assistant

# --- REQUIRED: Encryption key for OAuth tokens at rest ---
# Generate with: openssl rand -hex 32
# NOVA_ENCRYPTION_KEY=

# --- OPTIONAL: Support Tickets (Resend email + webhooks) ---
# RESEND_API_KEY=re_xxxxx          # Resend API key from resend.com
# RESEND_WEBHOOK_SECRET=whsec_xxxxx # Resend webhook secret (starts with whsec_)
# TICKET_SUPPORT_FROM=support@yourdomain.com # Email address for outgoing support tickets
# TICKET_OPERATOR_USER_ID=<your-nova-user-id> # Operator user ID for inbound ticket intake
# TELEGRAM_ADMIN_ID=<your-telegram-id>        # Telegram chat ID to receive ticket approval cards
# TICKET_DEPLOY_DRYRUN=true                   # Set to false to enable real deploys from the worker

# --- OPTIONAL: AI Video ---
# HEYGEN_API_KEY=                  # HeyGen avatar video API key
# FAL_API_KEY=                     # Fal.ai text-to-video API key

# --- OPTIONAL: OAuth Integrations (connected via the web dashboard) ---
# GOOGLE_CLIENT_ID=                # Google OAuth client ID (also used for YouTube)
# GOOGLE_CLIENT_SECRET=            # Google OAuth client secret (also used for YouTube)
# NOTION_CLIENT_ID=                # Notion OAuth client ID
# NOTION_CLIENT_SECRET=            # Notion OAuth client secret
# ZOOM_CLIENT_ID=                  # Zoom OAuth app client ID
# ZOOM_CLIENT_SECRET=              # Zoom OAuth app client secret
# TIKTOK_CLIENT_KEY=               # TikTok OAuth client key (developers.tiktok.com)
# TIKTOK_CLIENT_SECRET=            # TikTok OAuth client secret

# --- OPTIONAL: Executive Board (shared Postgres + PostgREST backend) ---
# The board needs one shared PostgREST endpoint reachable by Nova + all exec nodes.
#
# Recommended: self-host it (no supabase.com account needed). Bring the stack up with:
#   bash deploy/board/setup.sh
# then copy the BOARD_DB_URL / BOARD_DB_KEY it prints here.
# BOARD_DB_URL=                    # Board PostgREST base URL (e.g. http://localhost:3005)
# BOARD_DB_KEY=                    # Signed JWT for the trusted nova_board role

# Legacy aliases (still honored): a supabase.com project works unchanged.
#   BOARD_DB_URL falls back to SUPABASE_URL
#   BOARD_DB_KEY falls back to SUPABASE_SERVICE_ROLE_KEY, then SUPABASE_ANON_KEY
# SUPABASE_URL=                    # Supabase project URL (legacy alias for BOARD_DB_URL)
# SUPABASE_SERVICE_ROLE_KEY=       # Service role key (legacy alias for BOARD_DB_KEY; board tables use RLS)

# --- OPTIONAL: Legacy Migration ---
# SUPABASE_ANON_KEY=               # Supabase anon key (only for migration from old setup)

# --- OPTIONAL: Memwright (long-term memory service) ---
# Nova degrades gracefully if memwright isn't running (defaults shown).
# MEMWRIGHT_URL=http://localhost:8765
# MEMWRIGHT_DATA_DIR=./data/memwright

# ── Sandbox (P0 trust layer) ────────────────────────────────────────────────
# Where agent tool executions run. "local" = host process (default, current
# behavior — zero change). "docker" = hardened container: read-only root,
# dropped capabilities, no-new-privileges, per-user workspace mount only (never
# the repo or host secrets), resource caps, and a credential env allowlist.
# Requires the image: docker build -t nova-sandbox:latest deploy/sandbox
# Falls back to local with a warning if Docker is unavailable.
#
# docker-mode auth (NOVA_SANDBOX_SHARE_AUTH):
#   Default "true" (subscription-first): the host's OAuth credential files are
#   mounted READ-ONLY into the container and each CLI is pointed at them
#   (claude via CLAUDE_CONFIG_DIR, codex via CODEX_HOME, gemini via a workspace
#   symlink). Plain API keys are NOT forwarded, so docker mode uses the SAME
#   subscription as the host rather than switching to per-token billing.
#     - Linux (incl. the VPS): claude ~/.claude/.credentials.json mounts directly.
#     - macOS: claude auth is in the Keychain (not a file) — run `claude
#       setup-token` and export CLAUDE_CODE_OAUTH_TOKEN for docker subscription.
#       gemini/codex use ~/.gemini and ~/.codex files on both platforms.
#   Set NOVA_SANDBOX_SHARE_AUTH=false for strict isolation: no credential mounts,
#   API keys (ANTHROPIC_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY) forwarded
#   instead. Trade-off: sharing OAuth gives a (prompt-injectable) sandboxed agent
#   read access to the subscription token, same exposure class as an API key.
# NOVA_SANDBOX_SHARE_AUTH=true
# docker-mode MCP: tool access via mcp2cli works (baked into the image);
# --mcp-config file passthrough and gemini's temp-HOME MCP settings do not apply
# inside the container yet — use the local backend if you need those.
NOVA_SANDBOX_BACKEND=local
NOVA_SANDBOX_IMAGE=nova-sandbox:latest
# Optional resource caps for docker mode (defaults shown):
# NOVA_SANDBOX_PIDS_LIMIT=512
# NOVA_SANDBOX_MEMORY=2g
# NOVA_SANDBOX_CPUS=2

# ── Agent environment (least-privilege) ─────────────────────────
# Agent subprocesses get only the vars they need (base + provider auth + the
# credentials their MCP servers reference). Prevents an injected command from
# reading unrelated secrets. Set to false to pass the full host env (debugging).
# NOVA_AGENT_ENV_STRICT=false
# Comma-separated extra vars to always pass through to agents:
# NOVA_AGENT_ENV_PASSTHROUGH=FOO,BAR

# ── Egress leak firewall ─────────────────────────────────────────
# Redacts secrets from chat replies, scrubs secrets+PII from logs, and hard-blocks
# secrets leaving at the execute boundary. PII is never blocked in chat. Set off to disable.
# NOVA_LEAK_FIREWALL=off
# NOVA_LEAK_BLOCK_EXECUTE=off   # downgrade the execute secret-block to redact-only
# NOVA_LEAK_ALLOW=token1,token2 # known-safe values to never flag

# ── Untrusted-input firewall ─────────────────────────────────────
# Neutralizes tool/web/email content before it enters an agent prompt, and never lets
# untrusted input auto-approve consequential actions. Set off to disable neutralization
# (provenance-bound auto-approve stays on regardless). NOVA_UNTRUSTED_FIREWALL=off

# ── RTK (Rust Token Killer) ──────────────────────────────────────
# Installed by bootstrap.sh and ON by default when the `rtk` binary is present:
# Nova routes its own shell through `rtk` to compress command output (git, build,
# test, grep…) by 60–90% before it re-enters an agent's context. Safe by design —
# unknown commands pass through unchanged. Not applied under the docker sandbox
# backend (the binary isn't in the container). Set to off/false/0/no to disable.
# NOVA_RTK=off
