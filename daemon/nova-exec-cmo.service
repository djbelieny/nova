[Unit]
Description=Nova Executive - CMO
After=network.target nova-relay.service

[Service]
Type=simple
User=nova
WorkingDirectory=/opt/nova
ExecStart=/home/nova/.bun/bin/bun run --env-file=.env.cmo src/executive-node.ts --role cmo
Restart=always
RestartSec=10

Environment=HOME=/home/nova
Environment=PATH=/home/nova/.bun/bin:/usr/local/bin:/usr/bin:/bin

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nova-exec-cmo

[Install]
WantedBy=multi-user.target
