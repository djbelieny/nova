[Unit]
Description=Nova Voice Server
After=network.target

[Service]
Type=simple
User=nova
WorkingDirectory=/opt/nova
EnvironmentFile=/opt/nova/.env
Environment=HOME=/home/nova
Environment=PATH=/home/nova/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/bun run src/voice-server.ts
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nova-voice

[Install]
WantedBy=multi-user.target
