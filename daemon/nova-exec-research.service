[Unit]
Description=Nova Executive - Research
After=network.target nova-relay.service

[Service]
Type=simple
User=nova
WorkingDirectory=/opt/nova
ExecStart=/home/nova/.bun/bin/bun run --env-file=.env.research src/executive-node.ts --role research
Restart=always
RestartSec=10

Environment=HOME=/home/nova
Environment=PATH=/home/nova/.bun/bin:/usr/local/bin:/usr/bin:/bin

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nova-exec-research

[Install]
WantedBy=multi-user.target
