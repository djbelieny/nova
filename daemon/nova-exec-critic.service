[Unit]
Description=Nova Executive - Critic
After=network-online.target nova.service
Wants=network-online.target

[Service]
Type=simple
User=nova
Group=nova
WorkingDirectory=/opt/nova
EnvironmentFile=/opt/nova/.env.critic
Environment=CLAUDE_PATH=/usr/bin/claude
Environment=PROJECT_DIR=/opt/nova
Environment=NOVA_DIR=/opt/nova/.nova
Environment=HOME=/home/nova
ExecStart=/usr/local/bin/bun run src/executive-node.ts --role critic
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nova-exec-critic

[Install]
WantedBy=multi-user.target
