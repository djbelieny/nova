[Unit]
Description=Nova Executive - CTO
After=network-online.target nova-relay.service
Wants=network-online.target

[Service]
Type=simple
User=nova
Group=nova
WorkingDirectory=/opt/nova
EnvironmentFile=/opt/nova/.env.cto
Environment=CLAUDE_PATH=/usr/bin/claude
Environment=PROJECT_DIR=/opt/nova
Environment=NOVA_DIR=/opt/nova/.nova
Environment=HOME=/home/nova
ExecStart=/usr/local/bin/bun run src/executive-node.ts --role cto
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nova-exec-cto

[Install]
WantedBy=multi-user.target
