# Caddyfile for Nova Portability
# Usage:
#   Set NOVA_DOMAIN environment variable before starting:
#   export NOVA_DOMAIN=nova.example.com
#   docker-compose up -d caddy
#
# The domain substitution happens automatically via caddy's env plugin.
# If NOVA_DOMAIN is not set, caddy will use the literal string.

{$NOVA_DOMAIN} {
    reverse_proxy /voice/* voice:8080
    reverse_proxy /miniapp/* miniapp:3034
    reverse_proxy /dashboard/* dashboard:3033
    reverse_proxy /webhook/* relay:3036
}
