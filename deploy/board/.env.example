# deploy/board/.env — secrets for the self-hosted board stack.
# Copy to deploy/board/.env (gitignored) or let deploy/board/setup.sh generate one.
# docker compose auto-loads this file for variable substitution.

# Postgres superuser (owns the schema; used by init scripts).
POSTGRES_USER=nova
POSTGRES_DB=nova_board
POSTGRES_PASSWORD=change-me-strong-password

# Password for the "authenticator" login role PostgREST connects as.
AUTHENTICATOR_PASSWORD=change-me-authenticator-password

# HS256 secret PostgREST verifies request JWTs with (min 32 chars).
PGRST_JWT_SECRET=change-me-at-least-32-chars-long-secret

# Host port the nginx proxy publishes (Nova's BOARD_DB_URL points here).
BOARD_PROXY_PORT=3005

# The signed JWT that grants the trusted nova_board role. setup.sh mints this from
# PGRST_JWT_SECRET with claim {"role":"nova_board"}. Put it in Nova's .env as BOARD_DB_KEY.
# BOARD_DB_KEY=eyJ...
